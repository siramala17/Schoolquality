// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EXECUTIVE
  TEACHER
}

enum AssignmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

/// ข้อมูลโรงเรียน — single row, id = "default"
model School {
  id           String   @id @default("default")
  name         String
  department   String
  address      String?
  logoData     Bytes?
  logoType     String?
  updatedAt    DateTime @updatedAt
}

/// จัดการปีการศึกษา
model AcademicYear {
  id     String  @id @default(cuid())
  year   String  @unique
  active Boolean @default(false)

  assignments Assignment[]
}

/// จัดการภาคเรียน
model Semester {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  assignments Assignment[]
}

/// จัดการรอบที่
model Round {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  assignments Assignment[]
}

/// จัดการชั้นเรียน
model Classroom {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  assignments Assignment[]
}

/// กลุ่มสาระการเรียนรู้
model SubjectGroup {
  id    String @id @default(cuid())
  name  String
  order Int    @default(0)

  users       User[]
  assignments Assignment[]
}

/// เกณฑ์ระดับคุณภาพ
model QualityLevel {
  id       String @id @default(cuid())
  minScore Float
  maxScore Float
  label    String
  color    String
  order    Int    @default(0)
}

/// จัดการแบบประเมิน
model AssessmentForm {
  id     String   @id @default(cuid())
  name   String
  active Boolean  @default(true)

  domains     Domain[]
  assignments Assignment[]
}

model Domain {
  id     String @id @default(cuid())
  name   String
  order  Int    @default(0)
  formId String
  form   AssessmentForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  items Item[]
}

model Item {
  id       String @id @default(cuid())
  name     String
  order    Int    @default(0)
  domainId String
  domain   Domain @relation(fields: [domainId], references: [id], onDelete: Cascade)

  scores ItemScore[]
}

model User {
  id             String   @id @default(cuid())
  email          String?  @unique // ไม่บังคับ — ผู้ใช้ที่ไม่มีอีเมลจะเข้าสู่ระบบไม่ได้ แต่ถูกนิเทศ/เป็นกรรมการได้
  name           String
  role           Role     @default(TEACHER)
  position       String?
  subjectGroupId String?
  subjectGroup   SubjectGroup? @relation(fields: [subjectGroupId], references: [id])
  avatarData     Bytes?
  avatarType     String?
  signatureData  String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  assignmentsAsTeacher Assignment[]      @relation("AssignmentTeacher")
  committeeSeats       CommitteeMember[]
}

/// มอบหมายชุดประเมิน — one teacher, one round/semester/year
model Assignment {
  id                   String           @id @default(cuid())
  status               AssignmentStatus @default(PENDING)
  acknowledgedAt       DateTime?
  teacherSignatureData String?
  createdAt            DateTime         @default(now())

  teacherId      String
  teacher        User          @relation("AssignmentTeacher", fields: [teacherId], references: [id])
  formId         String
  form           AssessmentForm @relation(fields: [formId], references: [id])
  academicYearId String
  academicYear   AcademicYear  @relation(fields: [academicYearId], references: [id])
  semesterId     String
  semester       Semester      @relation(fields: [semesterId], references: [id])
  roundId        String
  round          Round         @relation(fields: [roundId], references: [id])
  classroomId    String?
  classroom      Classroom?    @relation(fields: [classroomId], references: [id])
  subjectGroupId String?
  subjectGroup   SubjectGroup? @relation(fields: [subjectGroupId], references: [id])

  committee CommitteeMember[]

  @@unique([teacherId, roundId, semesterId, academicYearId])
}

/// แต่งตั้งกรรมการ
model CommitteeMember {
  id        String @id @default(cuid())
  roleLabel String?
  order     Int    @default(0)

  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])

  evaluation Evaluation?

  @@unique([assignmentId, userId])
}

/// ผลการประเมินของกรรมการหนึ่งคน
model Evaluation {
  id            String   @id @default(cuid())
  submittedAt   DateTime?
  strengths     String?
  improvements  String?
  suggestions   String?
  signatureData String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  committeeMemberId String          @unique
  committeeMember   CommitteeMember @relation(fields: [committeeMemberId], references: [id], onDelete: Cascade)

  scores   ItemScore[]
  evidence Evidence[]
}

model ItemScore {
  id           String @id @default(cuid())
  score        Int
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  itemId       String
  item         Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, itemId])
}

/// รูปภาพประกอบการนิเทศ
model Evidence {
  id         String   @id @default(cuid())
  fileName   String
  fileType   String
  fileData   Bytes
  uploadedAt DateTime @default(now())

  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
}
